# Backend Environment Variables
# Copy this file to .env and update the values

# Environment (development or production)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String
# For local development: mongodb://localhost:27017/legal-register
# For production: Use MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/legal-register

# JWT Configuration
# IMPORTANT: Generate a strong secret for production (min 32 characters)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-change-in-production
JWT_EXPIRE=7d

# Email Configuration (Gmail with App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password

# CORS Origin
# For development: http://localhost:5173
# For production: Your frontend URL (e.g., https://your-frontend.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Cron Secret (for securing cron endpoints in production)
# Generate a random string for production
CRON_SECRET=your-secure-cron-secret-key
